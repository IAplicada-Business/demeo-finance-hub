# Copie para .env.test (nunca commitar .env.test).
# Valores entre <colchetes> são removidos automaticamente pelos scripts.

# URL pública onde o Playwright abre o app.
# demeo-finance-hub.lovable.app redireciona para produção — use o domínio final:
APP_URL=https://auroragfe.com

# Supabase (mesmo projeto do .env)
VITE_SUPABASE_URL=https://SEU_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_key

# ── Admin (Gestora) — aba "Gestão" no /login ─────────────────────────────
TEST_ADMIN_EMAIL=gestora@exemplo.com
TEST_ADMIN_PASSWORD=

# ── Portal (Cliente) — aba "Cliente" no /login ───────────────────────────
# Deve existir em auth.users E em user_client_mapping (Admin → Usuários).
# Rode: node scripts/check-test-credentials.mjs
TEST_PORTAL_EMAIL=cliente@exemplo.com
TEST_PORTAL_PASSWORD=

# Opcional — teste de role financeiro (06-portal.spec.ts)
TEST_PORTAL_FINANCEIRO_EMAIL=
TEST_PORTAL_FINANCEIRO_PASSWORD=

# UUID do cliente principal nos testes de fluxo
TEST_CLIENT_ID=

# Token de proposta pública (/p/proposta/<TOKEN>) para E2E de captação
TEST_PROPOSAL_TOKEN=
